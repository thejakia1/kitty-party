    "scrollbarSlider.activeBackground": "#ff5a5f66",
    "pickerGroup.foreground": "#ff5a5f",
    "pickerGroup.border": "#1d3d2a",
    "quickInput.background": "#15301f",
    "quickInputList.focusBackground": "#ff5a5f42",
    "notifications.background": "#15301f",
    "notifications.border": "#1d3d2a",
