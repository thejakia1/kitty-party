    "gitDecoration.ignoredResourceForeground": "#5f9a78",
    "gitDecoration.conflictingResourceForeground": "#ffc46b",
    "gitDecoration.submoduleResourceForeground": "#ffe58a",
    "terminal.background": "#051812",
    "terminal.foreground": "#e9fbe0",
    "terminal.selectionBackground": "#4ddb7a4d",
    "terminalCursor.foreground": "#ff5c7c",
    "terminal.ansiBlack": "#16402f",
    "terminal.ansiBrightBlack": "#5f9a78",
    "terminal.ansiRed": "#ff5c7c",
    "terminal.ansiBrightRed": "#ff8099",
    "terminal.ansiGreen": "#4ddb7a",
    "terminal.ansiBrightGreen": "#74e397",
    "terminal.ansiYellow": "#ffe58a",
    "terminal.ansiBrightYellow": "#ffeba4",
    "terminal.ansiBlue": "#7fb8ff",
    "terminal.ansiBrightBlue": "#9bc8ff",
    "terminal.ansiMagenta": "#e0a8ff",
    "terminal.ansiBrightMagenta": "#e7bbff",
    "terminal.ansiCyan": "#7fe9e0",
    "terminal.ansiBrightCyan": "#9beee7",
    "terminal.ansiWhite": "#e9fbe0",
    "terminal.ansiBrightWhite": "#eefce7",
    "debugToolBar.background": "#16402f",
    "debugConsole.errorForeground": "#ff5c70",
    "testing.iconPassed": "#4ddb7a",
    "testing.iconFailed": "#ff5c70",
    "settings.headerForeground": "#e9fbe0",
    "settings.modifiedItemIndicator": "#4ddb7a",
    "extensionButton.prominentBackground": "#4ddb7a",
    "extensionButton.prominentForeground": "#05150d",
    "extensionButton.prominentHoverBackground": "#ff5c7c",
    "charts.red": "#ff5c70",
    "charts.green": "#4ddb7a",
    "charts.blue": "#7fd1ff",
    "charts.yellow": "#ffc46b",
    "charts.purple": "#4ddb7a"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6fa588",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b9f27c"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#4ddb7a"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffb35c"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffb35c"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff6b88"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ff8aa0"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5be3c0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#ffe58a"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e9fbe0"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#ffcdbf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "This and self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ff6b88",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#c9efd2"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8fbfa2"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ff6b88"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffb35c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#ff5c7c"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7fe9e0"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4ddb7a"
      }
    },
    {
      "name": "Imports and modules",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#ff6b88"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5be3c0"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#c9efd2"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#4ddb7a"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#ffb35c"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4ddb7a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffb35c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffe58a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#ff5c7c"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5be3c0"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6fa588",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4ddb7a"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff5c70"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7fd1ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5c70"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#ffe58a",
    "interface": "#ffe58a",
    "enum": "#ffe58a",
    "typeParameter": "#ffe58a",
    "function": "#5be3c0",
    "method": "#5be3c0",
    "property": "#c9efd2",
    "parameter": {
      "foreground": "#ffcdbf",
      "italic": true
    },
    "namespace": "#ffe58a",
    "variable": "#e9fbe0",
    "variable.readonly": "#ffb35c",
    "enumMember": "#ffb35c",
    "keyword.controlFlow": "#ff6b88",
    "decorator": "#ff5c7c"
  }
}
