    "panelSectionHeader.background": "#051812",
    "input.background": "#051812",
    "input.foreground": "#e9fbe0",
    "input.border": "#1f5c42",
    "input.placeholderForeground": "#5f9a78",
    "inputOption.activeBorder": "#4ddb7a",
    "inputOption.activeBackground": "#4ddb7a40",
    "inputValidation.errorBorder": "#ff5c70",
    "inputValidation.warningBorder": "#ffc46b",
    "inputValidation.infoBorder": "#7fd1ff",
    "dropdown.background": "#16402f",
    "dropdown.foreground": "#e9fbe0",
    "dropdown.border": "#1f5c42",
    "button.background": "#4ddb7a",
    "button.foreground": "#05150d",
    "button.hoverBackground": "#ff5c7c",
    "button.secondaryBackground": "#16402f",
    "button.secondaryForeground": "#e9fbe0",
    "button.secondaryHoverBackground": "#4ddb7a40",
    "badge.background": "#ff5c7c",
    "badge.foreground": "#1a0509",
    "progressBar.background": "#4ddb7a",
    "checkbox.background": "#051812",
    "checkbox.border": "#1f5c42",
    "scrollbar.shadow": "#0000004d",
    "scrollbarSlider.background": "#4ddb7a29",
    "scrollbarSlider.hoverBackground": "#4ddb7a47",
    "scrollbarSlider.activeBackground": "#4ddb7a66",
    "pickerGroup.foreground": "#4ddb7a",
    "pickerGroup.border": "#1f5c42",
    "quickInput.background": "#16402f",
    "quickInputList.focusBackground": "#4ddb7a42",
    "notifications.background": "#16402f",
    "notifications.border": "#1f5c42",
    "notificationCenterHeader.background": "#051812",
    "notificationLink.foreground": "#4ddb7a",
    "peekView.border": "#4ddb7a",
    "peekViewEditor.background": "#051812",
