    "button.hoverBackground": "#5ed67a",
    "button.secondaryBackground": "#1a2d23",
    "button.secondaryForeground": "#eaf4e4",
    "button.secondaryHoverBackground": "#ff465540",
    "badge.background": "#5ed67a",
    "badge.foreground": "#1a0808",
    "progressBar.background": "#ff4655",
    "checkbox.background": "#0a130e",
    "checkbox.border": "#21402f",
    "scrollbar.shadow": "#0000000f",
    "scrollbarSlider.background": "#ff465529",
    "scrollbarSlider.hoverBackground": "#ff465547",
    "scrollbarSlider.activeBackground": "#ff465566",
    "pickerGroup.foreground": "#ff4655",
    "pickerGroup.border": "#21402f",
    "quickInput.background": "#1a2d23",
    "quickInputList.focusBackground": "#ff465542",
    "notifications.background": "#1a2d23",
    "notifications.border": "#21402f",
    "notificationCenterHeader.background": "#0a130e",
    "notificationLink.foreground": "#ff4655",
    "peekView.border": "#ff4655",
