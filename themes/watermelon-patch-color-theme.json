    "inputOption.activeBackground": "#ff465540",
    "inputValidation.errorBorder": "#ff5c6c",
    "inputValidation.warningBorder": "#ffc46b",
    "inputValidation.infoBorder": "#7fd1ff",
    "dropdown.background": "#1a2d23",
    "dropdown.foreground": "#eaf4e4",
    "dropdown.border": "#21402f",
    "button.background": "#ff4655",
