    "terminal.ansiBrightBlack": "#5f7c69",
    "terminal.ansiRed": "#ff4655",
    "terminal.ansiBrightRed": "#ff6f7a",
    "terminal.ansiGreen": "#5ed67a",
    "terminal.ansiBrightGreen": "#81df97",
    "terminal.ansiYellow": "#f3e9a0",
    "terminal.ansiBrightYellow": "#f6eeb5",
    "terminal.ansiBlue": "#7fb8ff",
    "terminal.ansiBrightBlue": "#9bc8ff",
    "terminal.ansiMagenta": "#d9a0ff",
    "terminal.ansiBrightMagenta": "#e1b5ff",
    "terminal.ansiCyan": "#7fe0d0",
    "terminal.ansiBrightCyan": "#9be7da",
    "terminal.ansiWhite": "#eaf4e4",
    "terminal.ansiBrightWhite": "#eff6ea",
