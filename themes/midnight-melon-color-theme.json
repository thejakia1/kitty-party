    "testing.iconFailed": "#ff6b7a",
    "settings.headerForeground": "#fff3ee",
    "settings.modifiedItemIndicator": "#ff7a8c",
    "extensionButton.prominentBackground": "#ff7a8c",
    "extensionButton.prominentForeground": "#2a0610",
