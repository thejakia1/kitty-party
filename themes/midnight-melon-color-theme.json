    "dropdown.border": "#33252a",
    "button.background": "#ff4d5a",
    "button.foreground": "#1a0809",
    "button.hoverBackground": "#6fe08a",
    "button.secondaryBackground": "#261c1f",
    "button.secondaryForeground": "#f3ebe8",
