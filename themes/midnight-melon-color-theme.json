    "terminal.ansiBrightBlack": "#76625f",
    "terminal.ansiRed": "#ff4d5a",
    "terminal.ansiBrightRed": "#ff747e",
    "terminal.ansiGreen": "#6fe08a",
    "terminal.ansiBrightGreen": "#8fe7a4",
    "terminal.ansiYellow": "#f3e9a0",
    "terminal.ansiBrightYellow": "#f6eeb5",
    "terminal.ansiBlue": "#8fb4ff",
    "terminal.ansiBrightBlue": "#a8c5ff",
    "terminal.ansiMagenta": "#c9a0ff",
    "terminal.ansiBrightMagenta": "#d5b5ff",
    "terminal.ansiCyan": "#80e6ff",
    "terminal.ansiBrightCyan": "#9cecff",
