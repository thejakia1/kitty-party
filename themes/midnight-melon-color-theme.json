    "pickerGroup.foreground": "#ff4d5a",
    "pickerGroup.border": "#33252a",
    "quickInput.background": "#261c1f",
    "quickInputList.focusBackground": "#ff4d5a42",
    "notifications.background": "#261c1f",
    "notifications.border": "#33252a",
    "notificationCenterHeader.background": "#0f0b0d",
